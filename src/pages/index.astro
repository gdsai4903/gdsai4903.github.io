---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Gagandeep Singh — Data Engineer in Winnipeg, MB. Building production data platforms on Microsoft Fabric, Azure Databricks, SQL Server, and Oracle."
    />
    <title>Gagandeep Singh — Data Engineer</title>
  </head>
  <body class="min-h-full bg-[#ffffff] text-[#0a0a0a]">
    <Nav />
    <main>
      <Hero />
      <About />
    </main>
    <Footer />
  </body>
</html>
