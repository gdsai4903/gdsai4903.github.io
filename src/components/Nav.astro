---
const links = [
  { label: 'Projects', href: '#projects' },
  { label: 'Writeups', href: '#writeups' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class="sticky top-0 z-50 bg-[#ffffff]/95 backdrop-blur-sm border-b border-[#e5e7eb]">
  <div class="mx-auto w-full max-w-[1100px] px-6 md:px-10 flex items-center justify-between h-14">
    <a
      href="/"
      class="font-mono text-xs font-medium tracking-wider uppercase text-[#0a0a0a] hover:text-[#5975a4] transition-colors"
    >
      Gagandeep Singh
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8" role="list">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="text-sm text-[#525866] hover:text-[#0a0a0a] transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Toggle navigation"
      class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-1.5"
    >
      <span class="nav-bar block w-5 h-px bg-[#0a0a0a] transition-all duration-200"></span>
      <span class="nav-bar block w-5 h-px bg-[#0a0a0a] transition-all duration-200"></span>
      <span class="nav-bar block w-5 h-px bg-[#0a0a0a] transition-all duration-200"></span>
    </button>
  </div>

  <!-- Mobile panel -->
  <div
    id="nav-mobile"
    class="hidden md:hidden border-t border-[#e5e7eb] bg-[#ffffff]"
    aria-hidden="true"
  >
    <ul class="mx-auto w-full max-w-[1100px] px-6 py-4 flex flex-col gap-3" role="list">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="block text-sm text-[#525866] hover:text-[#0a0a0a] transition-colors py-1"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.setAttribute('aria-hidden', String(isOpen));
    menu?.classList.toggle('hidden');
  });

  // Close mobile nav when a link is clicked
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      menu.classList.add('hidden');
    });
  });
</script>
